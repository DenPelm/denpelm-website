---
import Card from "../ui/Card.astro";
import { formatDate } from "../../utils/dates";
import type { CollectionEntry } from "astro:content";

const basePath = import.meta.env.BASE_URL;

interface Props {
    reflection: CollectionEntry<"reflections">;
    className?: string;
}

const { reflection, className = "" } = Astro.props;
const data = reflection.data;
const formattedDate = formatDate(data.date);
---

<Card class={`reflection-card ${className}`}>
    <article>
        <div class="cover-container">
            <a href={`${basePath}/reflections/${reflection.id}`} class="cover-link">
                <img
                    src={`${basePath}${data.cover}`}
                    alt={data.title}
                    class="cover"
                />
            </a>
        </div>
        <div class="content">
            <h3>{data.title}</h3>
            <span class="date">{formattedDate}</span>
            <p class="description">
                {data.description}
            </p>
            <a href={`${basePath}/reflections/${reflection.id}`} class="read-more">
                Read article →
            </a>
        </div>
    </article>
</Card>

<style>
    article {
        display: flex;
        flex-direction: column;
        height: 100%;
    }
    
    .cover-container {
        width: 100%;
        max-width: 500px;
        margin: 0 auto var(--spacing-sm);
    }
    
    .cover-link {
        display: block;
        transition: opacity 0.2s ease, transform 0.2s ease;
        border-radius: var(--radius);
        overflow: hidden;
    }
    
    .cover-link:hover {
        opacity: 0.85;
        transform: scale(1.02);
    }
    
    .cover {
        width: 100%;
        aspect-ratio: 16/9;
        object-fit: cover;
        border-radius: var(--radius);
        display: block;
    }
    
    .content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        flex: 1;
    }
    
    h3 {
        font-size: 1.25rem;
        line-height: 1.3;
    }
    
    .date {
        color: var(--color-muted);
        font-size: 0.9rem;
    }
    
    .description {
        color: var(--color-muted);
        font-size: 0.95rem;
        line-height: 1.5;
        flex: 1;
    }
    
    .read-more {
        color: var(--color-accent);
        font-weight: 500;
        margin-top: auto;
        transition: opacity 0.2s;
        width: fit-content;
    }
    
    .read-more:hover {
        opacity: 0.8;
    }
</style>