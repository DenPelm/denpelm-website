---
import Card from "../ui/Card.astro";
import StreamingLinks from "./StreamingLinks.astro";
import { formatDate } from "../../utils/dates";
import { getStreamingServices } from "../../utils/releaseHelpers";
import type { CollectionEntry } from "astro:content";

const basePath = import.meta.env.BASE_URL;

interface Props {
    release: CollectionEntry<"releases">;
}

const { release } = Astro.props;
const data = release.data;
const formattedDate = formatDate(data.date);
const services = getStreamingServices(data.streaming);
---

<Card>
    <article class="release-card">
        <a href={`${basePath}/releases/${release.id}`} class="cover-link">
            <img
                src={`${basePath}${data.cover}`}
                alt={data.title}
                class="cover"
            />
        </a>
        <div class="content">
            <h2>{data.title}</h2>
            <div class="meta">
                <span>{formattedDate}</span>
                {data.label && (
                    <>
                        <span>•</span>
                        <span>{data.label}</span>
                    </>
                )}
            </div>
            <div class="genres">
                {data.genres.map(genre => (
                    <span class="genre">
                        {genre}
                    </span>
                ))}
            </div>
            <div class="description-wrapper">
                <p class="description">
                    {data.description}
                </p>
            </div>
            <button
                class="toggle-description"
                type="button"
                aria-expanded="false"
            >
                <span class="toggle-label">Read more</span>
                <span class="toggle-icon" aria-hidden="true">↓</span>
            </button>
            <a href={`${basePath}/releases/${release.id}`} class="details-link">
                View release →
            </a>
            <StreamingLinks services={services} />
        </div>
    </article>
</Card>

<script>
    const COLLAPSED_HEIGHT = 120;

    document.querySelectorAll('.release-card').forEach(card => {
        const wrapper = card.querySelector<HTMLElement>('.description-wrapper');
        const button = card.querySelector<HTMLButtonElement>('.toggle-description');

        if (!wrapper || !button) return;

        const needsTruncation = wrapper.scrollHeight > COLLAPSED_HEIGHT + 5;

        if (!needsTruncation) {
            button.style.display = 'none';
            return;
        }

        wrapper.style.maxHeight = `${COLLAPSED_HEIGHT}px`;
        wrapper.classList.add('collapsed');

        const label = button.querySelector('.toggle-label');
        const icon = button.querySelector('.toggle-icon');

        button.addEventListener('click', () => {
            const isExpanded = button.getAttribute('aria-expanded') === 'true';

            if (isExpanded) {
                wrapper.style.maxHeight = `${COLLAPSED_HEIGHT}px`;
                wrapper.classList.add('collapsed');
                button.setAttribute('aria-expanded', 'false');
                if (label) label.textContent = 'Read more';
                if (icon) icon.textContent = '↓';
            } else {
                wrapper.style.maxHeight = `${wrapper.scrollHeight}px`;
                wrapper.classList.remove('collapsed');
                button.setAttribute('aria-expanded', 'true');
                if (label) label.textContent = 'Read less';
                if (icon) icon.textContent = '↑';
            }
        });
    });
</script>

<style>
    .release-card {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: 2rem;
    }
    
    .cover-link {
        display: block;
        width: 100%;
        height: fit-content;
        align-self: start;
        line-height: 0;
        transition: opacity 0.2s ease, transform 0.2s ease;
        border-radius: var(--radius);
        overflow: hidden;
    }
    
    .cover-link:hover {
        opacity: 0.85;
        transform: scale(1.02);
    }
    
    .cover {
        width: 100%;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: var(--radius);
        display: block;
    }
    
    .content {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    
    .meta {
        display: flex;
        gap: .5rem;
        color: var(--color-muted);
        font-size: .95rem;
    }
    
    .genres {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }
    
    .genre {
        padding: .35rem .8rem;
        border-radius: 999px;
        background: rgba(255,255,255,.06);
        color: var(--color-text);
        font-size: .8rem;
    }
    
    .description-wrapper {
        overflow: hidden;
        transition: max-height 0.4s ease;
    }
    
    .description-wrapper.collapsed {
        position: relative;
    }
    
    .description-wrapper.collapsed::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40px;
        background: linear-gradient(
            to bottom,
            transparent,
            rgba(27, 27, 27, 0.95)
        );
        pointer-events: none;
    }
    
    .description {
        color: var(--color-muted);
        max-width: 60ch;
        white-space: pre-line;
        margin: 0;
    }
    
    .toggle-description {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0;
        background: none;
        border: none;
        color: var(--color-accent);
        font: inherit;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        width: fit-content;
        transition: opacity 0.2s;
    }
    
    .toggle-description:hover {
        opacity: 0.8;
    }
    
    .toggle-icon {
        transition: transform 0.3s ease;
    }
    
    .details-link {
        color: var(--color-accent);
        font-weight: 500;
        transition: opacity 0.2s;
        width: fit-content;
    }
    
    .details-link:hover {
        opacity: 0.8;
    }
    
    @media (max-width: 700px) {
        .release-card {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
        .cover-link {
            max-width: 400px;
            margin: 0 auto;
        }
    }
</style>