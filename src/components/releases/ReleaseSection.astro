---
import ReleaseCard from "./ReleaseCard.astro";

import type { CollectionEntry } from "astro:content";

interface Props {

    title: string;

    releases: CollectionEntry<"releases">[];

}

const { title, releases } = Astro.props;

const sortedReleases = [...releases].sort(
    (a, b) =>
        b.data.date.getTime() -
        a.data.date.getTime()
);

const initialCount = 2;

const hasMore = sortedReleases.length > initialCount;
---

<section class="release-section">

    <header class="section-header">

        <h2>{title}</h2>

        {
            hasMore && (

                <button
                    class="toggle-button"
                    type="button"
                    aria-expanded="false"
                >
                    <span class="toggle-label">
                        Show all
                    </span>

                    <span
                        class="toggle-icon"
                        aria-hidden="true"
                    >
                        ↓
                    </span>
                </button>

            )
        }

    </header>


    <div class="release-grid">

        {
            sortedReleases.map(
                (release, index) => (

                    <div
                        class:list={[
                            "release-item",
                            index >= initialCount &&
                                "release-item-hidden"
                        ]}
                    >
                        <ReleaseCard
                            release={release}
                        />
                    </div>

                )
            )
        }

    </div>

</section>


<script>

    const sections =
        document.querySelectorAll(
            ".release-section"
        );

    sections.forEach(section => {

        const button =
            section.querySelector(
                ".toggle-button"
            );

        const hiddenItems =
            section.querySelectorAll(
                ".release-item-hidden"
            );

        if (!button || hiddenItems.length === 0) {

            return;

        }

        const label =
            button.querySelector(
                ".toggle-label"
            );

        const icon =
            button.querySelector(
                ".toggle-icon"
            );

        button.addEventListener(
            "click",
            () => {

                const expanded =
                    button.getAttribute(
                        "aria-expanded"
                    ) === "true";

                hiddenItems.forEach(item => {

                    item.classList.toggle(
                        "release-item-hidden",
                        expanded
                    );

                });

                button.setAttribute(
                    "aria-expanded",
                    String(!expanded)
                );

                if (label) {

                    label.textContent =
                        expanded
                            ? "Show all"
                            : "Show less";

                }

                if (icon) {

                    icon.textContent =
                        expanded
                            ? "↓"
                            : "↑";

                }

            }
        );

    });

</script>


<style>

    .release-section {

        margin-bottom: var(--spacing-lg);

    }


    .section-header {

        display: flex;

        align-items: center;

        justify-content: space-between;

        gap: var(--spacing-md);

        margin-bottom: var(--spacing-md);

    }


    .section-header h2 {

        font-size: 1.75rem;

        line-height: 1.2;

    }


    .toggle-button {

        display: inline-flex;

        align-items: center;

        gap: .5rem;

        padding: .5rem .9rem;

        border: 1px solid #444;

        border-radius: 999px;

        background: transparent;

        color: var(--color-text);

        font: inherit;

        font-size: .9rem;

        cursor: pointer;

        transition:
            background .2s,
            border-color .2s;

    }


    .toggle-button:hover {

        background: rgba(255,255,255,.06);

        border-color: #666;

    }


    .toggle-icon {

        transition: transform .2s;

    }


    .release-grid {

        display: grid;

        gap: var(--spacing-md);

    }


    .release-item-hidden {

        display: none;

    }

</style>
