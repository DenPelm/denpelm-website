---
const basePath = import.meta.env.BASE_URL;

const pages = [
    {
        href: `${basePath}/`,
        title: "Home"
    },
    {
        href: `${basePath}/releases`,
        title: "Releases"
    },
    {
        href: `${basePath}/about`,
        title: "About"
    },
    {
        href: `${basePath}/reflections`,
        title: "Reflections"
    },
    {
        href: `${basePath}/samples`,
        title: "Samples & Presets"
    },
    {
        href: `${basePath}/contact`,
        title: "Contact"
    }
];

const currentPath = Astro.url.pathname;
---

<nav class="main-nav">
    <div class="container">
        {pages.map(page => {
            const isActive = currentPath === page.href || 
                (page.href !== `${basePath}/` && currentPath.startsWith(page.href));
            return (
                <a
                    href={page.href}
                    class={isActive ? "active" : ""}
                >
                    {page.title}
                </a>
            );
        })}
    </div>
</nav>