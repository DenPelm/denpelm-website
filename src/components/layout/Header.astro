---
const basePath = import.meta.env.BASE_URL
---
<header class="site-header">
    <div class="container">
        <a href={`${basePath}/`} class="logo-link">
            <img  
                src={`${basePath}/design/dp_logo_white.png`} 
                alt="DenPelm" 
                class="logo"
            />
        </a>
        <h1 class="site-title">
            <a href={`${basePath}/`}>
                DenPelm
            </a>
        </h1>
    </div>
</header>

<style>
    .site-header .container {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    
    .logo-link {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        transition: opacity 0.2s;
    }
    
    .logo-link:hover {
        opacity: 0.85;
    }
    
    .logo {
        height: 50px;
        width: auto;
        display: block;
    }
    
    .site-title {
        font-size: 1.75rem;
        font-weight: 600;
        letter-spacing: 0.02em;
        margin: 0;
        line-height: 1;
    }
    
    .site-title a {
        color: inherit;
        text-decoration: none;
        transition: opacity 0.2s;
    }
    
    .site-title a:hover {
        opacity: 0.85;
    }
    
    @media (max-width: 700px) {
        .logo {
            height: 40px;
        }
        
        .site-title {
            font-size: 1.4rem;
        }
        
        .site-header .container {
            gap: 1rem;
        }
    }
</style>