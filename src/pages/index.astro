---
import MainLayout from "../layouts/MainLayout.astro";
import ReleaseCard from "../components/releases/ReleaseCard.astro";
import ReflectionCard from "../components/reflections/ReflectionCard.astro";
import SocialLinks from "../components/socials/SocialLinks.astro";
import { getCollection } from "astro:content";

const releases = await getCollection("releases");
const reflections = await getCollection("reflections");

const sortedReleases = releases
    .filter(r => r.data.releaseType != "unofficial")
    .toSorted(
        (a, b) => b.data.date.getTime() - a.data.date.getTime()
    );

const latestRelease = sortedReleases[0];

const featuredReleases = releases
    .filter(r => r.data.featured === true)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
    .slice(0, 2);

const latestReflection = reflections
    .filter(r => r.data.featured === true)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];

---

<MainLayout>
    <section class="hero">
        <div class="hero-content">
            <h1>DenPelm</h1>
            <p class="intro">
                Music producer who writes aggressive and melodic music, trying to bring something worthwhile into this world and become the best version of himself. Mainly focused on Dubstep and its subgenres such as Orchestral Dubstep and Melodic Dubstep.
            </p>
        </div>
        <div class="hero-image">
            <img
                src="/design/denpelm_2.jpg"
                alt="DenPelm"
                class="artist-photo"
            />
        </div>
    </section>
    
    {latestRelease && (
        <section class="section">
            <h2>Latest Release</h2>
            <ReleaseCard release={latestRelease} />
        </section>
    )}
    
    {featuredReleases.length > 0 && (
        <section class="section">
            <h2>Featured Releases</h2>
            <div class="featured-list">
                {featuredReleases.map((release) => (
                    <ReleaseCard release={release} />
                ))}
            </div>
        </section>
    )}
    
    {latestReflection && (
        <section class="section">
            <h2>Latest Reflection</h2>
            <div class="reflection-wrapper">
                <ReflectionCard reflection={latestReflection} />
            </div>
        </section>
    )}
    
    <section class="section">
        <h2>Links</h2>
        <SocialLinks />
    </section>
</MainLayout>

<style>
    .hero {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: var(--spacing-lg);
        align-items: center;
        margin-bottom: var(--spacing-lg);
    }
    
    .hero-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }
    
    h1 {
        font-size: 3rem;
        line-height: 1.1;
    }
    
    .intro {
        font-size: 1.2rem;
        color: var(--color-muted);
        max-width: 60ch;
        line-height: 1.6;
    }
    
    .hero-image {
        flex-shrink: 0;
    }
    
    .artist-photo {
        width: 300px;
        height: 300px;
        object-fit: cover;
        border-radius: var(--radius);
    }
    
    .section {
        margin-bottom: var(--spacing-lg);
    }
    
    .section h2 {
        font-size: 2rem;
        margin-bottom: var(--spacing-md);
    }
    
    .featured-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }
    
    .reflection-wrapper {
        max-width: 600px;
    }
    
    @media (max-width: 900px) {
        .hero {
            grid-template-columns: 1fr;
            text-align: center;
        }
        
        .hero-content {
            align-items: center;
        }
        
        .hero-image {
            order: -1;
            margin: 0 auto;
        }
        
        .artist-photo {
            width: 250px;
            height: 250px;
        }
        
        h1 {
            font-size: 2.5rem;
        }
        
        .intro {
            font-size: 1.1rem;
        }
    }
</style>