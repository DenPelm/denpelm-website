---
import MainLayout from "../../layouts/MainLayout.astro";
import StreamingLinks from "../../components/releases/StreamingLinks.astro";
import { getStreamingServices } from "../../utils/releaseHelpers";

import { getCollection } from "astro:content";

import { formatDate } from "../../utils/dates";

export async function getStaticPaths() {

    const releases =
        await getCollection("releases");

    return releases.map(release => ({

        params: {
            slug: release.id
        },

        props: {
            release
        }

    }));

}

const { release } = Astro.props;

const data = release.data;

const services = getStreamingServices(data.streaming);

const formattedDate =
    formatDate(data.date);
---

<MainLayout
    title={`${data.title} — DenPelm`}
    description={data.description}
>

    <a
        href="/releases"
        class="back-link"
    >
        ← All releases
    </a>

    <article class="release-page">

        <div class="cover-container">

            <img
                src={data.cover}
                alt={data.title}
                class="cover"
            />

        </div>


        <div class="content">

            <h1>{data.title}</h1>


            <div class="meta">

                <span>{formattedDate}</span>

                {
                    data.label && (
                        <>
                            <span>•</span>
                            <span>{data.label}</span>
                        </>
                    )
                }

            </div>


            <div class="genres">

                {
                    data.genres.map(genre => (

                        <span class="genre">
                            {genre}
                        </span>

                    ))
                }

            </div>


            <div class="description">

                {data.description}

            </div>


            <StreamingLinks
                services={services}
            />

        </div>

    </article>

</MainLayout>


<style>

    .release-page {

        display: grid;

        grid-template-columns:
            minmax(0, 450px)
            minmax(0, 1fr);

        gap: var(--spacing-lg);

        align-items: start;

    }


    .cover-container {

        width: min(100%, 450px);

        margin-inline: auto;

    }


    .cover {

        display: block;

        width: 100%;

        aspect-ratio: 1;

        object-fit: cover;

        border-radius: var(--radius);

    }


    .content {

        display: flex;

        flex-direction: column;

        gap: 1.25rem;

    }


    .content h1 {

        font-size: 2.5rem;

        line-height: 1.15;

    }


    .meta {

        display: flex;

        gap: .5rem;

        color: var(--color-muted);

        font-size: .95rem;

    }


    .genres {

        display: flex;

        flex-wrap: wrap;

        gap: .5rem;

    }


    .genre {

        padding: .35rem .8rem;

        border-radius: 999px;

        background: rgba(255,255,255,.06);

        color: var(--color-text);

        font-size: .8rem;

    }


    .description {

        max-width: 70ch;

        color: var(--color-muted);

        white-space: pre-line;

    }

    .back-link {

        display: inline-block;

        margin-bottom: var(--spacing-md);

        color: var(--color-muted);

        transition: color .2s;

    }

    .back-link:hover {

        color: var(--color-text);

    }


    @media (max-width: 800px) {

        .release-page {

            grid-template-columns: 1fr;

        }

        .cover-container {

            width: min(100%, 500px);

        }

    }

</style>